# Copy to .env on the target server. Keep this file private and out of source control.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=ecom_app
MYSQL_PASSWORD=replace-with-a-strong-database-password

# Generate one strong random value and use the same value in every service that validates these JWTs.
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_ISSUER=org-access

ORDER_SYNC_KEY=replace-with-a-unique-random-key-at-least-32-characters
PAYMENT_SYNC_KEY=replace-with-a-unique-random-key-at-least-32-characters
FULFILLMENT_SYNC_KEY=replace-with-a-unique-random-key-at-least-32-characters
INVENTORY_SYNC_KEY=replace-with-a-unique-random-key-at-least-32-characters

# Optional email OTP delivery. Set all required values in the server's private environment file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Public API host used by a frontend build served without a same-origin reverse proxy.
# Leave empty when the web server proxies the frontend API paths to the local gateway.
VITE_API_BASE_URL=
